# Copy to .env.local (your computer), or set these in Cloudflare for
# staging/production. Nothing secret belongs in a NEXT_PUBLIC_* variable:
# those are baked into the public site. Never commit real values.

# ── Public site (Next.js) ──────────────────────────────────────────────────
# Which environment this build is for: local | staging | production
NEXT_PUBLIC_HELP_ENV=local
# Public address of the help site (links, AI connector URL, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the Be Guided API lives (the site's Ask AI widget calls
# <this>/api/v1/chat). Locally the admin serves it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101
# Where guide content lives (folder of products/modules/pages). Default: ./content
CONTENT_DIR=./content
# Include products marked "private" in this build? Leave false for any public deployment.
INCLUDE_PRIVATE_PRODUCTS=false

# ── Admin + API, local (npm run admin) ─────────────────────────────────────
# Port of the admin on this computer (listens on 127.0.0.1 only).
ADMIN_PORT=3101
# Where the public site runs locally ("View on site" links).
ADMIN_SITE_URL=http://localhost:3100
# Request queue + proposals that Claude reads on "run the guide queue".
ADMIN_STATE_DIR=.admin
# SQLite file for people, version history and the audit log (git-ignored).
ADMIN_DB_FILE=.admin/be-guided.db
# Name of the first owner, added on first start.
ADMIN_OWNER_NAME=Site Owner

# ── Ask AI (both local and Cloudflare) ─────────────────────────────────────
# Claude API key (SECRET). Without it, Ask AI answers "not switched on yet" (503).
# ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# Browser origins allowed to call /api/v1/chat (comma-separated).
CHAT_ALLOWED_ORIGINS=http://localhost:3100
# Questions per client address per minute.
CHAT_RATE_LIMIT_PER_MINUTE=10
# Cloudflare only: the published site's page index Ask AI reads.
# Default: the first CHAT_ALLOWED_ORIGINS address + /ask-ai/pages.json
# CHAT_CONTENT_URL=

# ── Connect your AI: MCP connector at /api/v1/mcp (local and Cloudflare) ────
# No key or sign-in: it serves published, public guide pages only.
# Browser origins allowed to call it (Claude/ChatGPT call from their servers
# without an Origin, which is always allowed; the site's own origin is added).
MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
# Requests per client address per minute (many users can share one Claude/ChatGPT address).
MCP_RATE_LIMIT_PER_MINUTE=120
# Cloudflare only: the published site's page index the connector reads.
# Default: CHAT_CONTENT_URL if set, else SITE_URL + /ask-ai/pages.json
# MCP_CONTENT_URL=

# ── Uploads ("Choose file…") ───────────────────────────────────────────────
UPLOAD_IMAGE_MAX_MB=15
# Cloudflare caps request bodies at 100 MB; the Worker uses at most 95.
UPLOAD_VIDEO_MAX_MB=200

# ── Admin + API on Cloudflare Workers only (wrangler.toml [vars] / secrets) ─
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>
# GITHUB_REPO=<org>/<repo>
# GITHUB_BRANCH=main
# GITHUB_CONTENT_DIR=content
# GITHUB_TOKEN=            (SECRET: fine-grained token, Contents read/write on that repo only)
# GITHUB_COMMITTER_NAME=Be Guided Admin
# GITHUB_COMMITTER_EMAIL=admin@beguided.invalid
# PAGES_DEPLOY_HOOK_URL=   (SECRET: Cloudflare Pages deploy hook for the public site)
# SITE_URL=https://help.example.com
# BOOTSTRAP_OWNER_EMAIL=   (first owner while People is empty)

# ── Contract tests against a running server (optional) ─────────────────────
# API_BASE_URL=http://localhost:3101
# API_TOKEN_OWNER= / API_TOKEN_EDITOR= / API_TOKEN_VIEWER=   (Cf-Access-Jwt-Assertion values)
