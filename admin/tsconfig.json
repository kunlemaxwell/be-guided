{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["../src/*"] }
  },
  "include": [
    "shared/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/vite.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../backend/src/**/*.ts",
    "../backend/tests/**/*.ts",
    "../backend/scripts/**/*.ts",
    "../vitest.config.mts"
  ]
}
