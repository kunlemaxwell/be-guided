{
  "name": "be-guided",
  "version": "1.0.0",
  "description": "Be Guided: a user guide site, admin and AI connectors you host on your own Cloudflare. Write and update guides with Claude, ChatGPT or Codex.",
  "scripts": {
    "setup": "bash scripts/cloudflare/setup.sh",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pagefind --site out",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs",
    "admin": "tsx backend/src/node.ts",
    "admin:typecheck": "tsc -p admin/tsconfig.json",
    "api:contract": "tsx backend/scripts/write-openapi.ts",
    "test:contract": "vitest run backend/tests/contract",
    "build:admin": "vite build --config admin/web/vite.config.ts",
    "cf:dev": "node scripts/build-studio.mjs && node scripts/build-admin-app.mjs && npm run build:admin && wrangler dev",
    "cf:deploy": "node scripts/build-studio.mjs && node scripts/build-admin-app.mjs && npm run build:admin && wrangler deploy",
    "studio:build": "node scripts/build-studio.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "0.19.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-query": "^5.62.16",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "gray-matter": "^4.0.3",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.6.3",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "pagefind": "1.5.2",
    "sharp": "^0.33.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "4.157.0"
  },
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kunlemaxwell/be-guided.git"
  },
  "engines": {
    "node": ">=20"
  }
}
